{
  "default": {
    "contentType": "binary/octet-stream"
  },
  "get": {
    "cacheControl": "max-age=60",
    "contentType": "text/plain",
    "owner": "mirror",
    "redirect": "/old"
  },
  "head": {
    "contentType": "text/plain",
    "owner": "mirror"
  },
  "pinned": {
    "cacheControl": "no-cache",
    "contentDisposition": "attachment; filename=\"foo.jpg\"",
    "contentLanguage": "de"
  },
  "replaced": {
    "cacheControl": "",
    "contentType": "application/json",
    "owner": "new"
  }
}
