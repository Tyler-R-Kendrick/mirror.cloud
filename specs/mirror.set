# specs/mirror.set — services generated into internal/generated.
# format: <service-id> <tier>
# comments start with #. `mirror spec add <id>` appends a line.
# emulate-tier (behavior packs in internal/services)
aws.s3 emulate
aws.dynamodb emulate
aws.sqs emulate
aws.sns emulate
aws.sts emulate
aws.iam emulate
aws.ssm emulate
aws.secretsmanager emulate
gcp.storage emulate
