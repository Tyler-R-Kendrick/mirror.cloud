        }
      },
      "ServiceData": {
        "type": "object",
        "properties": {
          "service": { "$ref": "#/components/schemas/RailwayService" }
        }
      },
      "ServiceDeleteResult": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/ServiceDeleteData" }
        }
      },
      "ServiceDeleteData": {
