        "properties": {
          "node": { "$ref": "#/components/schemas/RailwayProject" }
        }
      },
      "RailwayProjectEdgeList": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/RailwayProjectEdge" }
      },
      "RailwayProjectConnection": {
        "type": "object",
