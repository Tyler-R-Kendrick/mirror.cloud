    "/v1/global-config": {
      "get": {
        "operationId": "GetEdgeConfigs",
        "description": "The vendored document describes the answer as one config, under the sentence 'List of all global configs.' A list of configs cannot be one config, and the API answers an array; this operation replaces the document's with the answer a client reads.",
        "parameters": [
          {
            "name": "teamId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
