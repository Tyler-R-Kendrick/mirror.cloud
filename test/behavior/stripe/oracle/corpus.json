{"steps": [
  {"name": "c-create", "method": "POST", "path": "/v1/customers", "compare": "exact",
   "body": {"email": "corpus1@example.com", "name": "Corpus One", "metadata": {"src": "corpus"}}},
  {"name": "c-create-form", "method": "POST", "path": "/v1/customers", "compare": "exact",
   "bodyText": "email=corpus2%40example.com&description=Form+created", "contentType": "application/x-www-form-urlencoded"},
  {"name": "c-get", "method": "GET", "path": "/v1/customers/$ref:c-create.id", "compare": "exact"},
  {"name": "c-get-404", "method": "GET", "path": "/v1/customers/cus_nope", "compare": "exact"},
  {"name": "c-update", "method": "POST", "path": "/v1/customers/$ref:c-create.id", "compare": "exact",
   "body": {"name": "Corpus One Renamed"}},
  {"name": "c-list-email", "method": "GET", "path": "/v1/customers?email=corpus1@example.com", "compare": "exact"},
  {"name": "p-create", "method": "POST", "path": "/v1/products", "compare": "exact",
   "body": {"name": "Corpus Plan", "description": "A plan"}},
  {"name": "p-create-no-name", "method": "POST", "path": "/v1/products", "compare": "exact",
   "body": {"description": "nameless"}},
  {"name": "p-get", "method": "GET", "path": "/v1/products/$ref:p-create.id", "compare": "exact"},
  {"name": "p-get-404", "method": "GET", "path": "/v1/products/prod_nope", "compare": "exact"},
  {"name": "p-create-2", "method": "POST", "path": "/v1/products", "compare": "status",
   "body": {"name": "Corpus Plan Two"}},
  {"name": "p-create-3", "method": "POST", "path": "/v1/products", "compare": "status",
   "body": {"name": "Corpus Plan Three"}},
  {"name": "p-create-inactive", "method": "POST", "path": "/v1/products", "compare": "status",
   "bodyText": "name=Corpus+Inactive&active=false", "contentType": "application/x-www-form-urlencoded"},
  {"name": "p-list", "method": "GET", "path": "/v1/products?limit=2", "compare": "exact"},
  {"name": "p-list-page2", "method": "GET", "path": "/v1/products?limit=2&starting_after=$ref:p-list.data.1.id", "compare": "exact"},
  {"name": "p-list-ending", "method": "GET", "path": "/v1/products?limit=2&ending_before=$ref:p-list.data.0.id", "compare": "exact"},
  {"name": "p-list-active", "method": "GET", "path": "/v1/products?active=true", "compare": "exact"},
  {"name": "p-list-inactive", "method": "GET", "path": "/v1/products?active=false", "compare": "exact"},
  {"name": "pr-create", "method": "POST", "path": "/v1/prices", "compare": "exact",
   "body": {"currency": "USD", "product": "$ref:p-create.id", "unit_amount": 2000}},
  {"name": "pr-create-form", "method": "POST", "path": "/v1/prices", "compare": "exact",
   "bodyText": "currency=usd&product=$ref:p-create.id&unit_amount=500", "contentType": "application/x-www-form-urlencoded"},
  {"name": "pr-create-no-currency", "method": "POST", "path": "/v1/prices", "compare": "exact",
   "body": {"product": "$ref:p-create.id"}},
  {"name": "pr-create-no-product", "method": "POST", "path": "/v1/prices", "compare": "exact",
   "body": {"currency": "usd", "product": "prod_nope", "unit_amount": 100}},
  {"name": "pr-get-expand", "method": "GET", "path": "/v1/prices/$ref:pr-create.id?expand[]=product", "compare": "exact"},
  {"name": "pr-list-product", "method": "GET", "path": "/v1/prices?product=$ref:p-create.id", "compare": "exact"},
  {"name": "pi-create", "method": "POST", "path": "/v1/payment_intents", "compare": "exact",
   "body": {"amount": 5000, "currency": "usd", "customer": "$ref:c-create.id"}},
  {"name": "pi-create-form", "method": "POST", "path": "/v1/payment_intents", "compare": "exact",
   "bodyText": "amount=150&currency=eur", "contentType": "application/x-www-form-urlencoded"},
  {"name": "pi-create-missing", "method": "POST", "path": "/v1/payment_intents", "compare": "exact",
   "body": {}},
  {"name": "pi-create-bad-customer", "method": "POST", "path": "/v1/payment_intents", "compare": "exact",
   "body": {"amount": 100, "currency": "usd", "customer": "cus_nope"}},
  {"name": "pi-get-expand", "method": "GET", "path": "/v1/payment_intents/$ref:pi-create.id?expand[]=customer", "compare": "exact"},
  {"name": "pi-update", "method": "POST", "path": "/v1/payment_intents/$ref:pi-create.id", "compare": "exact",
   "body": {"payment_method": "pm_card_visa", "description": "updated"}},
  {"name": "pi-list-customer", "method": "GET", "path": "/v1/payment_intents?customer=$ref:c-create.id", "compare": "exact"},
  {"name": "pi-list-status", "method": "GET", "path": "/v1/payment_intents?status=requires_payment_method", "compare": "exact"},
  {"name": "pi-confirm", "method": "POST", "path": "/v1/payment_intents/$ref:pi-create.id/confirm", "compare": "exact", "body": {}},
  {"name": "ch-list-pi", "method": "GET", "path": "/v1/charges?payment_intent=$ref:pi-create.id", "compare": "exact"},
  {"name": "ch-get-expand", "method": "GET", "path": "/v1/charges/$ref:ch-list-pi.data.0.id?expand[]=payment_intent", "compare": "exact"},
  {"name": "pi-create-cancel", "method": "POST", "path": "/v1/payment_intents", "compare": "status",
   "body": {"amount": 75, "currency": "usd"}},
  {"name": "pi-cancel", "method": "POST", "path": "/v1/payment_intents/$ref:pi-create-cancel.id/cancel", "compare": "exact"},
  {"name": "pi-confirm-canceled", "method": "POST", "path": "/v1/payment_intents/$ref:pi-create-cancel.id/confirm", "compare": "exact", "body": {}},
  {"name": "cs-create", "method": "POST", "path": "/v1/checkout/sessions", "compare": "exact",
   "body": {"mode": "payment", "customer": "$ref:c-create.id", "success_url": "https://example.com/ok?sid={CHECKOUT_SESSION_ID}", "cancel_url": "https://example.com/no", "line_items": [{"price": "$ref:pr-create.id", "quantity": 2}]}},
  {"name": "cs-get", "method": "GET", "path": "/v1/checkout/sessions/$ref:cs-create.id", "compare": "exact"},
  {"name": "cs-create-no-mode", "method": "POST", "path": "/v1/checkout/sessions", "compare": "exact", "body": {}},
  {"name": "cs-create-bad-line", "method": "POST", "path": "/v1/checkout/sessions", "compare": "exact",
   "body": {"mode": "payment", "line_items": [{"price": "price_nope", "quantity": 1}]}},
  {"name": "cs-create-bad-qty", "method": "POST", "path": "/v1/checkout/sessions", "compare": "exact",
   "body": {"mode": "payment", "line_items": [{"price": "$ref:pr-create.id", "quantity": 0}]}},
  {"name": "cs-list-customer", "method": "GET", "path": "/v1/checkout/sessions?customer=$ref:c-create.id", "compare": "exact"},
  {"name": "cs-page", "method": "GET", "path": "/checkout/$ref:cs-create.id", "compare": "status"},
  {"name": "cs-complete", "method": "POST", "path": "/checkout/$ref:cs-create.id/complete", "compare": "status", "noFollow": true, "location": "https://example.com/ok?sid=$ref:cs-create.id"},
  {"name": "cs-page-after", "method": "GET", "path": "/checkout/$ref:cs-create.id", "compare": "status"},
  {"name": "cs-create-expire", "method": "POST", "path": "/v1/checkout/sessions", "compare": "status",
   "body": {"mode": "payment"}},
  {"name": "cs-expire", "method": "POST", "path": "/v1/checkout/sessions/$ref:cs-create-expire.id/expire", "compare": "exact"},
  {"name": "cs-expire-again", "method": "POST", "path": "/v1/checkout/sessions/$ref:cs-create-expire.id/expire", "compare": "exact"},
  {"name": "cs-complete-missing", "method": "POST", "path": "/checkout/cs_nope/complete", "compare": "status", "noFollow": true, "location": "/checkout/cs_nope"},
  {"name": "css-create", "method": "POST", "path": "/v1/customer_sessions", "compare": "exact",
   "body": {"customer": "$ref:c-create.id", "components": {"payment_element": {"enabled": true}}}},
  {"name": "css-missing-customer", "method": "POST", "path": "/v1/customer_sessions", "compare": "exact", "body": {}},
  {"name": "css-bad-customer", "method": "POST", "path": "/v1/customer_sessions", "compare": "exact",
   "body": {"customer": "cus_nope"}},
  {"name": "pm-list", "method": "GET", "path": "/v1/payment_methods?customer=$ref:c-create.id", "compare": "exact"},
  {"name": "pm-bad-customer", "method": "GET", "path": "/v1/payment_methods?customer=cus_nope", "compare": "exact"},
  {"name": "c-delete", "method": "DELETE", "path": "/v1/customers/$ref:c-create.id", "compare": "exact"},
  {"name": "c-get-gone", "method": "GET", "path": "/v1/customers/$ref:c-create.id", "compare": "exact"},
  {"name": "pi-get-orphaned", "method": "GET", "path": "/v1/payment_intents/$ref:pi-create.id", "compare": "exact"},
  {"name": "ch-get-orphaned", "method": "GET", "path": "/v1/charges/$ref:ch-list-pi.data.0.id", "compare": "exact"},
  {"name": "cs-get-orphaned", "method": "GET", "path": "/v1/checkout/sessions/$ref:cs-create.id", "compare": "exact"}
]}
