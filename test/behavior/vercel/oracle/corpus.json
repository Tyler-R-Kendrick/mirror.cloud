{
  "comment": "Canonical request corpus for the vercel-labs/emulate differential. scripts/capture-vercel-oracle.py replays it against the pinned oracle and records answers.json; oracle_differential_test.go replays it against mirror and compares. Fields: service routes to the bundle and host; refs substitute a value from a previous answer ({\"$ref\": \"step.path\"} \u2014 dot path into the decoded JSON body); compare is exact (normalized), fields (named members only), or status. KV is outside the oracle's surface (emulate has no KV service \u2014 Vercel KV is Upstash, not implemented in the vercel package), so no kv steps exist to compare against. env-create is excluded: the oracle's team-scope resolution answers 400 for its own seeded personal account, a seed artifact rather than API shape.",
  "steps": [
    {
      "name": "user",
      "service": "vercel.api",
      "method": "GET",
      "path": "/v2/user",
      "compare": "fields",
      "fields": [
        "?user.username"
      ]
    },
    {
      "name": "create-project",
      "service": "vercel.api",
      "method": "POST",
      "path": "/v11/projects",
      "body": {
        "name": "corpus-app",
        "framework": "nextjs"
      },
      "compare": "fields",
      "fields": [
        "name",
        "framework"
      ]
    },
    {
      "name": "dup-project",
      "service": "vercel.api",
      "method": "POST",
      "path": "/v11/projects",
      "body": {
        "name": "corpus-app"
      },
      "compare": "status"
    },
    {
      "name": "list-projects",
      "service": "vercel.api",
      "method": "GET",
      "path": "/v10/projects",
      "compare": "fields",
      "fields": [
        "projects.0.name"
      ]
    },
    {
      "name": "get-project",
      "service": "vercel.api",
      "method": "GET",
      "path": "/v9/projects/corpus-app",
      "compare": "fields",
      "fields": [
        "name"
      ]
    },
    {
      "name": "patch-project",
      "service": "vercel.api",
      "method": "PATCH",
      "path": "/v9/projects/corpus-app",
      "body": {
        "framework": "vite"
      },
      "compare": "fields",
      "fields": [
        "framework"
      ]
    },
    {
      "name": "env-list",
      "service": "vercel.api",
      "method": "GET",
      "path": "/v10/projects/corpus-app/env",
      "compare": "fields",
      "fields": [
        "envs.0.key"
      ]
    },
    {
      "name": "env-get",
      "service": "vercel.api",
      "method": "GET",
      "path": "/v10/projects/corpus-app/env/ghost",
      "compare": "status"
    },
    {
      "name": "domains-add",
      "service": "vercel.api",
      "method": "POST",
      "path": "/v10/projects/corpus-app/domains",
      "body": {
        "name": "corpus.example.com"
      },
      "compare": "status"
    },
    {
      "name": "domains-list",
      "service": "vercel.api",
      "method": "GET",
      "path": "/v9/projects/corpus-app/domains",
      "compare": "fields",
      "fields": [
        "domains.0.name"
      ]
    },
    {
      "name": "domains-get",
      "service": "vercel.api",
      "method": "GET",
      "path": "/v9/projects/corpus-app/domains/corpus.example.com",
      "compare": "fields",
      "fields": [
        "name",
        "verified"
      ]
    },
    {
      "name": "domains-verify",
      "service": "vercel.api",
      "method": "POST",
      "path": "/v9/projects/corpus-app/domains/corpus.example.com/verify",
      "compare": "fields",
      "fields": [
        "verified"
      ]
    },
    {
      "name": "deploy",
      "service": "vercel.api",
      "method": "POST",
      "path": "/v13/deployments",
      "body": {
        "name": "corpus-app",
        "project": "corpus-app"
      },
      "compare": "fields",
      "fields": [
        "readyState"
      ]
    },
    {
      "name": "deployments-v6",
      "service": "vercel.api",
      "method": "GET",
      "path": "/v6/deployments",
      "compare": "fields",
      "fields": [
        "deployments.0.name"
